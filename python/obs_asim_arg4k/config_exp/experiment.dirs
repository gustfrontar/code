#!/bin/bash
#########################
# EXPERIMENT DEFINITION #
#########################
export EXPNAME=__EXPNAME__
export EXPNAME_OBS=__EXPNAME_OBS__
export EXPDIR=__EXPDIR__

##########################
# EXPERIMENT DIRECTORIES #
##########################
export LOGSDIR=$EXPDIR/LOGS
export SLURMDIR=$EXPDIR/SLURM
export HISTDIR=$(realpath $EXPDIR/HIST)

#######################
# ARCHIVE DIRECTORIES #
#######################
export H_LOGSDIR=__HISTDIR__/LOGS
export H_MONITDIR=__HISTDIR__/MONIT
export H_OBSDIR=__HISTDIR__/OBS
export H_PREPDIR=__HISTDIR__/PREP
