#!/bin/bash
### MAIN DIRECTORY
test ! $MAINDIR && export MAINDIR=$(realpath $PWD/..)

#######################
# CONF. & SOURCE      #
#######################
export BINDIR=$MAINDIR/bin
export CONFIGDIR=$MAINDIR/config_exp
export TOOLSDIR=$MAINDIR/modules/obs-tools
export SRCDIR=$TOOLSDIR/src
export UTILSDIR=$TOOLSDIR/utils

#######################
# LETKF OBS DIRS      #
#######################
export OBSDIR_RADARC=/home/ra000007/a04037/data/OBSwVR/RADARC/
export MONITDIR_RADARC=/home/ra000007/a04037/data/OBSDATA/RADARC/MONIT/

#######################
# RAW OBS DIRECTORIES #
#######################
export REPODIR_RADARC=/home/ra000007/a04037/data/DATOS_RADAR/

#######################
# AUX. DATA           #
#######################
export DOMAIN_GEO_EM=/home/ra000007/a04037/data/data_assimilation_exps/PREVENIR_LOWRESOLUTION_DA_FUGAKU_2024031900/WPS/geogrid/geo_em.d01.nc  #geo_em file corresponding to the model domain. Will be used to filter observations.

